# Backblaze B2 (required) — S3-compatible credentials.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region determines the S3 endpoint (https://s3.<region>.backblazeb2.com).
# Defaults to us-west-004; set it to match your bucket's region.
B2_REGION=us-west-004

# Optional. Base URL for building public object links (public buckets only).
# The app runs fine without it. Example: https://your-bucket.s3.us-west-004.backblazeb2.com
# B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=<keyID from B2, e.g. 00abcdef...>
# B2_APPLICATION_KEY=<applicationKey shown once by B2>
# B2_BUCKET_NAME=my-wsi-slides
# B2_REGION=us-west-004

# --- WSI feature-extraction pipeline (all optional; safe defaults shown) ---
# Inference device: auto (CUDA -> Apple MPS -> CPU), or force cpu/cuda/mps.
# EXTRACT_DEVICE=auto
# Finite MIL bag labels offered in the Ingest/Edit forms (comma-separated).
# MIL_BAG_LABELS=tumor,normal,unknown
# Where torchvision caches the ResNet50 encoder weights (~100 MB, downloaded
# once). Defaults to services/api/.torch_cache (gitignored).
# EXTRACT_MODEL_CACHE_DIR=
# Small freely-redistributable Aperio test slide used by the "sample slide"
# ingest option. Leave unset for the safe default (CMU-1-Small-Region.svs).
# SAMPLE_SLIDE_URL=

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
